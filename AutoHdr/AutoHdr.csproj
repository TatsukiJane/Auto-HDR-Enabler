<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AutoHdr</AssemblyName>
    <RootNamespace>AutoHdr</RootNamespace>
    <StartupObject>AutoHdr.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.8</Version>
    <Product>Auto HDR</Product>
    <Description>Turns HDR on in Windows when games start</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF0001: Fluent theme (ThemeMode), WFO5001: WinForms dark mode for the tray menu -->
    <!-- WFO0003: DPI is set in the manifest on purpose, WPF manages it -->
    <NoWarn>$(NoWarn);WPF0001;WFO5001;WFO0003;SYSLIB1054</NoWarn>
    <!-- The tray runs with administrator rights, while DOTNET_STARTUP_HOOKS is set by a regular user -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only needed for the tray icon: remove its global usings so it does not clash with WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
