<Window x:Class="AutoHdr.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AutoHdr.UI"
        Title="Auto HDR"
        Width="1080" Height="680" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">
    <Window.Resources>
        <ui:HdrBrushConverter x:Key="HdrBrush" />
        <ui:BoolToVisibleConverter x:Key="Visible" />
        <ui:BoolToVisibleConverter x:Key="Hidden" Invert="True" />

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="SettingCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="12,8,12,12">

        <!-- ================= Игры ================= -->
        <TabItem Header="{ui:Tr 'Игры', 'Games'}">
            <DockPanel Margin="0,12,0,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ScanButton" Content="{ui:Tr 'Найти игры', 'Find games'}" Style="{StaticResource ToolButton}" Click="Scan_Click"
                                ToolTip="{ui:Tr 'Steam, GOG, Epic, EA, Ubisoft, Xbox, Rockstar и добавленные папки', 'Steam, GOG, Epic, EA, Ubisoft, Xbox, Rockstar and added folders'}" />
                        <Button Content="{ui:Tr 'Добавить игру', 'Add game'}" Style="{StaticResource ToolButton}" Click="AddExe_Click"
                                ToolTip="{ui:Tr 'Выбрать exe игры, которой нет в библиотеках', 'Pick the exe of a game that is not in any library'}" />
                        <Button Content="{ui:Tr 'Добавить папку', 'Add folder'}" Style="{StaticResource ToolButton}" Click="AddFolder_Click"
                                ToolTip="{ui:Tr 'Папка с одной игрой или с несколькими играми в подпапках', 'A folder with one game, or with several games in subfolders'}" />
                        <Button x:Name="RecheckButton" Content="{ui:Tr 'Проверить HDR заново', 'Recheck HDR'}" Style="{StaticResource ToolButton}" Click="Recheck_Click"
                                ToolTip="{ui:Tr 'Снова запросить Steam и PCGamingWiki для всех игр, даже недавно проверенных', 'Query Steam and PCGamingWiki again for all games, even recently checked ones'}" />
                    </StackPanel>
                    <Grid Grid.Column="2" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" VerticalContentAlignment="Center" />
                        <TextBlock x:Name="SearchPlaceholder" Text="{ui:Tr 'Поиск', 'Search'}" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <ComboBox x:Name="FilterBox" Grid.Column="3" SelectedIndex="0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="{ui:Tr 'Все игры', 'All games'}" />
                        <ComboBoxItem Content="{ui:Tr 'С авто-HDR', 'With auto HDR'}" />
                        <ComboBoxItem Content="{ui:Tr 'HDR: есть', 'HDR: yes'}" />
                        <ComboBoxItem Content="{ui:Tr 'HDR: возможно', 'HDR: maybe'}" />
                        <ComboBoxItem Content="{ui:Tr 'HDR: нет', 'HDR: no'}" />
                        <ComboBoxItem Content="{ui:Tr 'Не проверены', 'Not checked'}" />
                        <ComboBoxItem Content="{ui:Tr 'Не установлены', 'Not installed'}" />
                    </ComboBox>
                </Grid>

                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,16,0"
                               Text="{ui:Tr 'Авто-HDR включается сам, если поддержку HDR подтвердили Steam или PCGamingWiki. «Ждать HDR» приостанавливает запуск игры, пока HDR не включится: это нужно играм, которые проверяют HDR в первые секунды', 'Auto HDR turns on by itself when Steam or PCGamingWiki confirms HDR support. “Wait for HDR” holds the game at launch until HDR is on: some games look for HDR only in the first seconds'}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
                        <ProgressBar Width="140" Height="4" Margin="0,0,10,0" Minimum="0" Maximum="1"
                                     Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}" />
                        <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Hint}"
                               Visibility="{Binding IsBusy, Converter={StaticResource Hidden}}" />
                </Grid>

                <Grid>
                    <DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              SelectionMode="Extended" SelectionUnit="FullRow" RowHeaderWidth="0"
                              IsSynchronizedWithCurrentItem="False"
                              EnableRowVirtualization="True" MouseDoubleClick="GamesGrid_DoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Missing}" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{ui:Tr 'Авто-HDR', 'Auto HDR'}" Width="96" SortMemberPath="Enabled"
                                                    ToolTipService.ToolTip="{ui:Tr 'Включать HDR, пока игра запущена', 'Turn HDR on while the game is running'}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding EnabledUi, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" MinWidth="0" Focusable="False"
                                                  ToolTip="{ui:Tr 'Включать HDR при запуске этой игры', 'Turn HDR on when this game starts'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{ui:Tr 'Игра', 'Game'}" Binding="{Binding Name}" IsReadOnly="True" Width="2*"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{ui:Tr 'Откуда', 'Source'}" Binding="{Binding SourceText}" IsReadOnly="True" Width="110"
                                                SortMemberPath="Source" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="HDR" Width="130" SortMemberPath="HdrSortKey"
                                                    ToolTipService.ToolTip="{ui:Tr 'Поддержка HDR по данным Steam, PCGamingWiki и файлов игры', 'HDR support according to Steam, PCGamingWiki and the game files'}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                                                    ToolTip="{Binding HdrTooltip}" ToolTipService.ShowDuration="30000">
                                            <Ellipse Width="9" Height="9" Margin="2,0,8,0" Fill="{Binding Hdr, Converter={StaticResource HdrBrush}}" />
                                            <TextBlock Text="{Binding HdrText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:Tr 'Ждать HDR', 'Wait for HDR'}" Width="124" SortMemberPath="HoldUntilHdr"
                                                    ToolTipService.ToolTip="{ui:Tr 'Приостанавливать запуск игры, пока HDR не включится. Для онлайн-игр с античитом это рискованно', 'Hold the game at launch until HDR is on. Risky for online games with anti-cheat'}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding HoldUi, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" MinWidth="0" Focusable="False"
                                                  ToolTip="{ui:Tr 'Приостанавливать запуск игры, пока HDR не включится', 'Hold the game at launch until HDR is on'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:Tr 'Расположение', 'Location'}" Width="3*" SortMemberPath="Location">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Location}" ToolTip="{Binding Location}" Style="{StaticResource CellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{ui:Tr 'Открыть папку', 'Open folder'}" Click="OpenFolder_Click" />
                                <MenuItem Header="{ui:Tr 'Открыть на PCGamingWiki', 'Open on PCGamingWiki'}" Click="OpenPcgw_Click" />
                                <Separator />
                                <MenuItem Header="{ui:Tr 'Проверить HDR заново', 'Recheck HDR'}" Click="RecheckSelected_Click" />
                                <MenuItem Header="{ui:Tr 'Сбросить ручную настройку авто-HDR', 'Reset manual auto HDR choice'}" Click="ResetOverride_Click" />
                                <Separator />
                                <MenuItem Header="{ui:Tr 'Убрать из списка', 'Remove from list'}" Click="Remove_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="{ui:Tr 'Игр пока нет', 'No games yet'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="{ui:Tr 'Найдите игры в библиотеках или добавьте их вручную', 'Find games in your libraries or add them manually'}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ================= Мониторы ================= -->
        <TabItem Header="{ui:Tr 'Мониторы', 'Displays'}">
            <DockPanel Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,12"
                           Text="{ui:Tr 'HDR переключается только на отмеченных мониторах. Новые мониторы и телевизоры добавляются с выключенным авто-HDR', 'HDR is switched only on checked displays. New displays and TVs are added with auto HDR off'}" />
                <DataGrid x:Name="MonitorsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" RowHeaderWidth="0"
                          CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{ui:Tr 'Авто-HDR', 'Auto HDR'}" Width="96"
                                                ToolTipService.ToolTip="{ui:Tr 'Включать HDR на мониторе, пока запущена игра', 'Turn HDR on for the display while a game is running'}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding AutoHdr, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HdrSupported}"
                                              HorizontalAlignment="Center" MinWidth="0" Focusable="False"
                                              ToolTip="{ui:Tr 'Включать HDR на этом мониторе, пока запущена игра', 'Turn HDR on for this display while a game is running'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{ui:Tr 'Монитор', 'Display'}" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{ui:Tr 'Состояние', 'Status'}" Binding="{Binding StateText}" IsReadOnly="True" Width="*"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center">
                                        <Button Content="{ui:Tr 'Переключить HDR', 'Toggle HDR'}" Padding="10,4" Margin="0,0,8,0" Click="ToggleMonitor_Click"
                                                ToolTip="{ui:Tr 'Включить или выключить HDR прямо сейчас, без игры', 'Turn HDR on or off right now, without a game'}"
                                                Visibility="{Binding CanToggle, Converter={StaticResource Visible}}" />
                                        <Button Content="{ui:Tr 'Забыть', 'Forget'}" Padding="10,4" Click="ForgetMonitor_Click"
                                                Visibility="{Binding CanForget, Converter={StaticResource Visible}}"
                                                ToolTip="{ui:Tr 'Убрать монитор из списка. Когда его подключат снова, он появится с выключенным авто-HDR', 'Remove the display from the list. When it is connected again, it comes back with auto HDR off'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ================= Настройки ================= -->
        <TabItem Header="{ui:Tr 'Настройки', 'Settings'}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,16" MaxWidth="760" HorizontalAlignment="Left">

                    <TextBlock Text="{ui:Tr 'Основные', 'General'}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutoSwitchCheck" Content="{ui:Tr 'Автопереключение HDR', 'Switch HDR automatically'}" Style="{StaticResource SettingCheck}"
                              Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0"
                               Text="{ui:Tr 'Пауза тоже доступна в меню значка в трее', 'You can also pause it from the tray icon menu'}" />

                    <CheckBox x:Name="AutostartCheck" Content="{ui:Tr 'Автозапуск при входе в Windows', 'Start with Windows'}" Style="{StaticResource SettingCheck}"
                              Margin="0,14,0,0" Click="Autostart_Click" />
                    <TextBlock x:Name="AutostartHint" Style="{StaticResource Hint}" Margin="28,2,0,0"
                               Text="{ui:Tr 'Auto HDR запускается через планировщик заданий с правами администратора, без окна UAC', 'Auto HDR starts through Task Scheduler with administrator rights, without a UAC prompt'}" />

                    <TextBlock x:Name="TrackingText" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="{ui:Tr 'Без прав администратора «Ждать HDR» не сможет приостановить игру, запущенную с правами администратора', 'Without administrator rights, “Wait for HDR” cannot hold a game that runs as administrator'}" />
                    <Button x:Name="ElevateButton" Content="{ui:Tr 'Перезапустить с правами администратора', 'Restart as administrator'}" HorizontalAlignment="Left"
                            Padding="12,6" Margin="0,8,0,0" Click="Elevate_Click" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="{ui:Tr 'Язык', 'Language'}" VerticalAlignment="Center" />
                        <ComboBox x:Name="LanguageBox" Width="200" Margin="12,0,0,0" SelectionChanged="Language_Changed">
                            <ComboBoxItem Content="{ui:Tr 'Как в Windows', 'Same as Windows'}" />
                            <ComboBoxItem Content="Русский" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Text="{ui:Tr 'После игры', 'After the game'}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="RestoreCheck" Content="{ui:Tr 'Возвращать прежний режим после выхода из игры', 'Restore the previous mode after the game exits'}" Style="{StaticResource SettingCheck}"
                              Checked="Restore_Changed" Unchecked="Restore_Changed" />
                    <CheckBox x:Name="ExitDelayCheck" Content="{ui:Tr 'Задержка перед выключением HDR', 'Delay before turning HDR off'}" Style="{StaticResource SettingCheck}"
                              Margin="0,14,0,0" Checked="ExitDelay_Changed" Unchecked="ExitDelay_Changed" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0"
                               Text="{ui:Tr 'Включите, если HDR мигает, когда лаунчер передаёт управление игре или игра перезапускается', 'Turn this on if HDR flickers when a launcher hands over to the game or the game restarts'}" />
                    <StackPanel Orientation="Horizontal" Margin="28,8,0,0"
                                Visibility="{Binding IsChecked, ElementName=ExitDelayCheck, Converter={StaticResource Visible}}">
                        <TextBlock Text="{ui:Tr 'Время задержки', 'Delay'}" VerticalAlignment="Center" />
                        <TextBox x:Name="ExitDelayBox" Width="72" Margin="12,0,8,0" TextAlignment="Right"
                                 TextChanged="ExitDelaySec_Changed" LostFocus="ExitDelaySec_LostFocus" />
                        <TextBlock Text="{ui:Tr 'с', 's'}" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox x:Name="NotifyCheck" Content="{ui:Tr 'Уведомления о переключении HDR', 'Notify when HDR switches'}" Style="{StaticResource SettingCheck}"
                              Margin="0,14,0,0" Checked="Notify_Changed" Unchecked="Notify_Changed" />

                    <TextBlock Text="{ui:Tr 'Поддержка HDR в играх', 'HDR support in games'}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="OnlineCheck" Content="{ui:Tr 'Проверять поддержку HDR в интернете', 'Check HDR support online'}" Style="{StaticResource SettingCheck}"
                              Checked="Online_Changed" Unchecked="Online_Changed" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0"
                               Text="{ui:Tr 'Данные берутся из Steam и PCGamingWiki. Без этой проверки остаётся только поиск упоминаний HDR в файлах игры', 'Data comes from Steam and PCGamingWiki. Without it, only the game files are searched for HDR mentions'}" />

                    <TextBlock Text="{ui:Tr 'Параметры запуска в Steam', 'Steam launch options'}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13"
                               Text="{ui:Tr 'Нужны редко: если игра проверяет HDR в первые секунды и не находит его, вставьте строку в Steam → Свойства игры → Параметры запуска. Тогда HDR включится до старта игры', 'Rarely needed: if a game looks for HDR in the first seconds and does not find it, paste this line into Steam → game Properties → Launch Options. HDR then turns on before the game starts'}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LaunchCommandBox" IsReadOnly="True" FontFamily="Consolas" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="{ui:Tr 'Скопировать', 'Copy'}" Padding="12,6" Margin="8,0,0,0" Click="CopyLaunch_Click" />
                    </Grid>

                    <TextBlock Text="{ui:Tr 'Данные', 'Data'}" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{ui:Tr 'Открыть папку с данными', 'Open data folder'}" Style="{StaticResource ToolButton}" Click="OpenDataDir_Click" />
                        <Button Content="{ui:Tr 'Открыть файл журнала', 'Open log file'}" Style="{StaticResource ToolButton}" Click="OpenLogFile_Click" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Журнал ================= -->
        <TabItem Header="{ui:Tr 'Журнал', 'Log'}">
            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{ui:Tr 'Открыть файл журнала', 'Open log file'}" Style="{StaticResource ToolButton}" Click="OpenLogFile_Click" />
                    <Button Content="{ui:Tr 'Очистить окно', 'Clear'}" Style="{StaticResource ToolButton}" Click="ClearJournal_Click" />
                </StackPanel>
                <TextBox x:Name="JournalBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" AcceptsReturn="True" />
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
