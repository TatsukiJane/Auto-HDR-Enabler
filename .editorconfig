root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,manifest,json}]
indent_size = 2

# Windows PowerShell 5.1 читает файлы без BOM в кодировке ANSI и портит кириллицу
[*.ps1]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false
